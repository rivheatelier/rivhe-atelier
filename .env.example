# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Public URL of the store (used in emails and SEO tags)
NEXT_PUBLIC_SITE_URL=https://rivhe.com

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this in the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Only for `npm run db:migrate` / `npm run db:seed` on your computer (not needed on Vercel).
# Supabase → Connect → Session pooler, with your database password.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Emails allowed into /admin (comma-separated). Each one also needs a user in
# Supabase → Authentication → Users.
ADMIN_EMAILS=owner@rivhe.com

# Optional: signs checkout shipping quotes. Defaults to a key derived from SUPABASE_SECRET_KEY.
# APP_SECRET=

# --- Email (pick one; without either, emails are only recorded in the admin) ---
# Resend (https://resend.com) — verify the rivhe.com domain first, then set EMAIL_FROM
RESEND_API_KEY=
# …or SMTP. Gmail: enable 2-Step Verification, create an App Password, write @ as %40:
#   smtps://yourname%40gmail.com:16-letter-app-password@smtp.gmail.com:465
SMTP_URL=
# Optional with SMTP (defaults to the SMTP login); required with Resend
EMAIL_FROM="RIVHÉ Atelier <hello@rivhe.com>"

# --- Shipping ---
# Biteship (https://biteship.com) live courier rates for Indonesia.
# Without it, checkout uses the built-in estimate table.
BITESHIP_API_KEY=

# --- Optional automatic payment matching ---
# Moota (https://moota.co) bank-mutation webhook secret. When set, incoming bank
# transfers whose amount matches exactly one pending order confirm it automatically.
MOOTA_WEBHOOK_SECRET=
